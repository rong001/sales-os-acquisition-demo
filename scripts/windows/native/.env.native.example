# Windows-native trial (no Docker). Copy to repo-root .env.native OR let
# Start-InternalTrial-Native.ps1 generate .env.native with random secrets.
# Never commit .env.native.
# Unpack tip: unzip/tar over source; KEEP your existing .env.native and .data/.

# Dedicated ports (never 5432/6379). Defaults avoid Sub2API/Garnet
# (Sub2API often occupies 15432 PG + 16379 Garnet — do NOT use those as Sales OS defaults).
# Successful trial set: 55433 / 56380 / 39300 / 19280
# Prior alternate pair also OK if free: 55432 / 56379
NATIVE_PG_PORT=55433
NATIVE_REDIS_PORT=56380
NATIVE_API_PORT=39300
NATIVE_WEB_PORT=19280

# Native MUST bind API to loopback. Docker leaves API_HOST unset → 0.0.0.0
API_HOST=127.0.0.1

POSTGRES_USER=sales
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=sales_os
# Filled by start script:
# DATABASE_URL=postgres://sales:...@127.0.0.1:55433/sales_os
# REDIS_URL=redis://127.0.0.1:56380

JWT_SECRET=CHANGE_ME
SEED_ON_BOOT=true
DEMO_AGENT_PASSWORD=CHANGE_ME
DEMO_AGENT2_PASSWORD=CHANGE_ME
DEMO_ADMIN_PASSWORD=CHANGE_ME
DEMO_MANAGER_PASSWORD=CHANGE_ME
DEMO_VIEWER_PASSWORD=CHANGE_ME
DEMO_TENANT_SLUG=demo
REAL_SMS_ENABLED=false
REAL_CALL_ENABLED=false
REAL_EMAIL_ENABLED=false
