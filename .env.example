# Copy to .env for local runs. Never commit .env.

POSTGRES_USER=sales
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=sales_os
DATABASE_URL=postgres://sales:CHANGE_ME@127.0.0.1:5432/sales_os
REDIS_URL=redis://127.0.0.1:6379

JWT_SECRET=CHANGE_ME
API_PORT=3100
PORT=3100
# Bind host: unset/0.0.0.0 for Docker; native Windows sets 127.0.0.1
# API_HOST=127.0.0.1
SEED_ON_BOOT=true
NODE_ENV=development

# Demo accounts (seed reads these). Use strong values outside local demos.
DEMO_AGENT_PASSWORD=CHANGE_ME
DEMO_ADMIN_PASSWORD=CHANGE_ME
DEMO_VIEWER_PASSWORD=CHANGE_ME
DEMO_AGENT2_PASSWORD=CHANGE_ME
DEMO_MANAGER_PASSWORD=CHANGE_ME
DEMO_TENANT_SLUG=demo

# Real SMS/Call providers — OFF by default. Any demo channel is labeled MOCK.
REAL_SMS_ENABLED=false
REAL_CALL_ENABLED=false
# SMS_PROVIDER_API_KEY=
# CALL_PROVIDER_API_KEY=

# Real email — OFF by default. Without SMTP_HOST, email attempts are UNDELIVERED (not success MOCK).
REAL_EMAIL_ENABLED=false
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=

# Public intake rate limit (Redis sliding window; IP+phone)
INTAKE_RATE_WINDOW_MS=60000
INTAKE_RATE_MAX=8

# P0P1 providers
CALL_PROVIDER=mock
WECOM_MODE=mock
