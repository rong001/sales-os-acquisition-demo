# Internal trial (Docker Compose). Copy to .env and replace every CHANGE_ME.
# Never commit .env. Do not pack real passwords or customer data.

COMPOSE_PROJECT_NAME=salesos_internal_trial

POSTGRES_USER=sales
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=sales_os

JWT_SECRET=CHANGE_ME
SEED_ON_BOOT=true

# Host publish (127.0.0.1 only in compose). Defaults match documented URLs.
HOST_WEB_PORT=18180
HOST_API_PORT=3100

# Demo accounts (seed on first boot). Emails: agent@ / agent2@ / manager@ / admin@ / viewer@demo.local
DEMO_AGENT_PASSWORD=CHANGE_ME
DEMO_AGENT2_PASSWORD=CHANGE_ME
DEMO_ADMIN_PASSWORD=CHANGE_ME
DEMO_MANAGER_PASSWORD=CHANGE_ME
DEMO_VIEWER_PASSWORD=CHANGE_ME
DEMO_TENANT_SLUG=demo

REAL_SMS_ENABLED=false
REAL_CALL_ENABLED=false
REAL_EMAIL_ENABLED=false
